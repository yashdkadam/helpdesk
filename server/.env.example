# Database (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk

# Server
NODE_ENV=development
PORT=3000

# Auth — set both to your public Railway URL in production (e.g. https://yourapp.railway.app)
BETTER_AUTH_SECRET=          # required: random 32+ char secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# AI (use one)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENAI_API_KEY=your-openai-api-key

# Email (optional — replies still work in-app without this)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=support@yourdomain.com

# Seed (only needed when running prisma/seed.ts)
SEED_ADMIN_EMAIL=               # email address for the bootstrap admin account
SEED_ADMIN_PASSWORD=            # strong password (min 12 chars recommended)
