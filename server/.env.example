DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
NODE_ENV=development
PORT=3000
BETTER_AUTH_SECRET=          # required: random 32+ char secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_URL=http://localhost:3000
SEED_ADMIN_EMAIL=               # required: email address for the bootstrap admin account
SEED_ADMIN_PASSWORD=            # required: strong password (min 12 chars recommended)